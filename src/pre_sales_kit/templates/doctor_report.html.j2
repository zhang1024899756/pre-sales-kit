<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ view.title }} · 现场体检报告</title>
<style>
{% include "_report.css" %}

.masthead {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 32px;
  align-items: end;
  padding-bottom: 22px;
  border-bottom: 2px solid var(--ink);
}

.wordmark {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--muted);
}

h1 {
  margin: 10px 0 6px;
  font-size: 30px;
  line-height: 1.15;
  font-weight: 650;
  letter-spacing: -0.01em;
}

.subtitle {
  font-size: 13px;
  color: var(--muted);
  overflow-wrap: anywhere;
}

.verdict {
  text-align: right;
  padding-bottom: 2px;
}

.verdict-word {
  display: block;
  font-size: 38px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.verdict[data-status="pass"] .verdict-word { color: var(--pass); }
.verdict[data-status="warn"] .verdict-word { color: var(--warn); }
.verdict[data-status="fail"] .verdict-word { color: var(--fail); }
.verdict[data-status="skip"] .verdict-word { color: var(--skip); }

.verdict-detail {
  display: block;
  max-width: 260px;
  margin-top: 10px;
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--muted);
}

.strip {
  display: flex;
  flex-wrap: wrap;
  border-bottom: 1px solid var(--rule);
}

.count {
  flex: 1 1 0;
  min-width: 108px;
  padding: 18px 16px 18px 0;
}

.count + .count {
  padding-left: 20px;
  border-left: 1px solid var(--rule);
}

.count .num {
  display: block;
  font-family: var(--mono);
  font-size: 26px;
  line-height: 1;
  font-weight: 600;
}

[data-status="pass"] .num { color: var(--pass); }
[data-status="warn"] .num { color: var(--warn); }
[data-status="fail"] .num { color: var(--fail); }
[data-status="skip"] .num { color: var(--skip); }

.count .lbl {
  display: block;
  margin-top: 6px;
  font-size: 12px;
  color: var(--muted);
}

.facts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px 28px;
  padding: 20px 0 0;
}

.facts dt {
  font-size: 10.5px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
}

.facts dd {
  margin-top: 3px;
  font-size: 13px;
  color: var(--ink-soft);
  overflow-wrap: anywhere;
}

.section-title {
  margin: 38px 0 4px;
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--muted);
}

.check {
  padding: 16px 0 14px;
  border-top: 1px solid var(--rule);
}

.check-head {
  display: flex;
  align-items: baseline;
  gap: 10px;
}

.check-mark {
  width: 13px;
  font-weight: 700;
}

.check-name {
  flex: 1 1 auto;
  font-size: 17px;
  font-weight: 600;
  line-height: 1.35;
}

.badge {
  flex: 0 0 auto;
  padding: 1px 6px;
  border: 1px solid var(--rule-strong);
  border-radius: var(--radius);
  font-family: var(--mono);
  font-size: 10.5px;
  color: var(--muted);
}

.check-dur {
  flex: 0 0 auto;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--muted);
}

.check-detail {
  margin: 7px 0 0 23px;
  font-size: 13.5px;
  color: var(--ink);
  overflow-wrap: anywhere;
}

.check-detail[data-status="warn"] { color: var(--warn); }
.check-detail[data-status="fail"] { color: var(--fail); }
.check-detail[data-status="skip"] { color: var(--muted); }

.check-hint {
  margin: 3px 0 0 23px;
  font-size: 12.5px;
  color: var(--muted);
}

.check-hint::before { content: "→ "; }

.items {
  list-style: none;
  margin-top: 8px;
  padding: 0;
}

.item {
  display: grid;
  grid-template-columns: 13px 200px minmax(0, 1fr);
  gap: 10px;
  padding: 3px 0;
}

.item .label {
  font-size: 13px;
  color: var(--ink-soft);
  overflow-wrap: anywhere;
}

.item .detail {
  font-size: 13px;
  color: var(--ink);
  overflow-wrap: anywhere;
}

.item[data-status="warn"] .detail { color: var(--warn); }
.item[data-status="fail"] .detail { color: var(--fail); }
.item[data-status="skip"] .detail { color: var(--muted); }

.item .hint {
  grid-column: 2 / 4;
  margin-top: 2px;
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--muted);
}

.item .hint::before {
  content: "→ ";
}

.fix-table {
  width: 100%;
  margin-top: 10px;
  border-collapse: collapse;
  font-size: 13px;
}

.fix-table th {
  padding: 6px 12px 6px 0;
  text-align: left;
  font-size: 10.5px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--muted);
  border-bottom: 1px solid var(--rule-strong);
}

.fix-table td {
  padding: 8px 12px 8px 0;
  vertical-align: top;
  border-bottom: 1px solid var(--rule);
}

.fix-table td:last-child,
.fix-table th:last-child {
  padding-right: 0;
}

.fix-table .mark {
  font-weight: 700;
}

.note {
  margin-top: 34px;
  padding: 14px 16px;
  border: 1px solid var(--rule);
  border-left: 3px solid var(--rule-strong);
  border-radius: var(--radius);
  font-size: 12.5px;
  line-height: 1.6;
  color: var(--muted);
}

.note strong {
  color: var(--ink-soft);
  font-weight: 600;
}

footer {
  margin-top: 36px;
  padding-top: 14px;
  border-top: 1px solid var(--rule);
  font-size: 11.5px;
  color: var(--muted);
  display: flex;
  flex-wrap: wrap;
  gap: 4px 16px;
  justify-content: space-between;
}

@media (max-width: 720px) {
  .masthead {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .verdict {
    text-align: left;
  }

  .verdict-detail {
    max-width: none;
  }

  h1 {
    font-size: 24px;
  }

  .facts {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .item {
    grid-template-columns: 13px minmax(0, 1fr);
  }

  .item .detail,
  .item .hint {
    grid-column: 2 / 3;
  }

  .fix-table thead {
    display: none;
  }

  .fix-table tr {
    display: block;
    padding: 8px 0;
    border-bottom: 1px solid var(--rule);
  }

  .fix-table td {
    display: block;
    padding: 0;
    border: 0;
  }
}
</style>
</head>
<body>
<div class="sheet">
  <header class="masthead">
    <div>
      <p class="wordmark">pre-sales-kit / kit doctor</p>
      <h1>{{ view.title }}</h1>
      <p class="subtitle">{% if view.name %}{{ view.name }} &middot; {% endif %}<span class="mono">{{ view.source }}</span></p>
    </div>
    <div class="verdict" data-status="{{ view.overall.status }}">
      <span class="verdict-word">{{ view.overall.word }}</span>
      <span class="verdict-detail">{{ view.overall.text }}</span>
    </div>
  </header>

  <section class="strip" aria-label="结果统计">
    {% for count in view.counts %}
    <div class="count" data-status="{{ count.status }}">
      <span class="num">{{ count.count }}</span>
      <span class="lbl">{{ count.label }}</span>
    </div>
    {% endfor %}
  </section>

  <dl class="facts">
    <div>
      <dt>开始时间</dt>
      <dd>{{ view.started.strftime("%Y-%m-%d %H:%M:%S") }}</dd>
    </div>
    <div>
      <dt>总耗时</dt>
      <dd>{{ view.duration }}</dd>
    </div>
    <div>
      <dt>检查项</dt>
      <dd>{{ view.total }} 项</dd>
    </div>
    {% for key, value in view.host.items() %}
    <div>
      <dt>{{ key }}</dt>
      <dd>{{ value }}</dd>
    </div>
    {% endfor %}
    <div>
      <dt>执行命令</dt>
      <dd class="mono">{{ view.command }}</dd>
    </div>
  </dl>

  <h2 class="section-title">检查明细</h2>
  <section aria-label="检查明细">
    {% for check in view.checks %}
    <article class="check" data-status="{{ check.status }}">
      <div class="check-head">
        <span class="check-mark mark" aria-hidden="true">{{ check.glyph }}</span>
        <span class="sr-only">{{ check.status_label }}</span>
        <h3 class="check-name">{{ check.name }}</h3>
        <span class="badge">{{ check.type }}</span>
        <span class="check-dur">{{ check.duration }}</span>
      </div>
      {% if not check.multi and check.rows %}
      {% set item = check.rows[0] %}
      <p class="check-detail" data-status="{{ item.status }}">{{ item.detail }}</p>
      {% if item.hint %}<p class="check-hint">{{ item.hint }}</p>{% endif %}
      {% else %}
      <ul class="items">
        {% for item in check.rows %}
        <li class="item" data-status="{{ item.status }}">
          <span class="mark" aria-hidden="true">{{ item.glyph }}</span>
          <span class="sr-only">{{ item.status_label }}</span>
          <span class="label">{{ item.label }}</span>
          <span class="detail">{{ item.detail }}</span>
          {% if item.hint %}
          <p class="hint">{{ item.hint }}</p>
          {% endif %}
        </li>
        {% endfor %}
        {% if check.error %}
        <li class="item" data-status="fail">
          <span class="mark" aria-hidden="true">&#10007;</span>
          <span class="label">执行错误</span>
          <span class="detail">{{ check.error }}</span>
        </li>
        {% endif %}
      </ul>
      {% endif %}
    </article>
    {% endfor %}
  </section>

  {% if view.fixes %}
  <h2 class="section-title">修复记录</h2>
  <section class="fixes" aria-label="修复记录">
    <table class="fix-table">
      <thead>
        <tr>
          <th>结果</th>
          <th>检查项</th>
          <th>动作</th>
          <th>复检</th>
          <th>说明</th>
        </tr>
      </thead>
      <tbody>
        {% for fix in view.fixes %}
        <tr data-status="{{ fix.status }}">
          <td class="mark">{{ "✓" if fix.status == "pass" else ("–" if fix.status == "skip" else "✗") }}</td>
          <td>{{ fix.check_name }}</td>
          <td>{{ fix.action_label }}</td>
          <td class="mono">{{ fix.before }} → {{ fix.after }}</td>
          <td>{{ fix.detail }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  <p class="note">
    <strong>怎么用这份报告：</strong>失败的项按顺序处理，警告项现场留意；所有检查都由声明文件
    驱动（<span class="mono">{{ view.source }}</span>），改 YAML 就能加检查，不用改代码。
  </p>

  <footer>
    <span>pre-sales-kit v{{ view.version }} · {{ view.generated.strftime("%Y-%m-%d %H:%M:%S") }}</span>
    <span>单文件报告 · 无外部资源 · 可直接转发或打印</span>
  </footer>
</div>
</body>
</html>
