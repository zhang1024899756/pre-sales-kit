<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ view.title }} · 数据预览</title>
<style>
{% include "_report.css" %}

.masthead {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 32px;
  align-items: end;
  padding-bottom: 22px;
  border-bottom: 2px solid var(--ink);
}

.wordmark {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--muted);
}

h1 {
  margin: 10px 0 6px;
  font-size: 28px;
  line-height: 1.15;
  font-weight: 650;
  letter-spacing: -0.01em;
}

.subtitle {
  font-size: 13px;
  color: var(--muted);
  overflow-wrap: anywhere;
}

.headline {
  text-align: right;
}

.headline .big {
  display: block;
  font-family: var(--mono);
  font-size: 34px;
  line-height: 1;
  font-weight: 600;
  color: var(--pass);
}

.headline .big.bad {
  color: var(--fail);
}

.headline .small {
  display: block;
  margin-top: 8px;
  font-size: 12.5px;
  color: var(--muted);
}

.strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-bottom: 1px solid var(--rule);
}

.strip > div {
  padding: 16px 16px 16px 0;
}

.strip > div + div {
  padding-left: 20px;
  border-left: 1px solid var(--rule);
}

.strip .k {
  font-size: 10.5px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
}

.strip .v {
  margin-top: 4px;
  font-family: var(--mono);
  font-size: 15px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 32px;
  margin-top: 28px;
}

.point {
  padding: 18px 0 16px;
  border-top: 1px solid var(--rule);
}

.point-header {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.point h3 {
  flex: 1 1 auto;
  font-size: 16px;
  font-weight: 600;
}

.point .unit {
  font-size: 12px;
  color: var(--muted);
  font-weight: 400;
}

.badge {
  padding: 1px 6px;
  border: 1px solid var(--rule-strong);
  border-radius: var(--radius);
  font-family: var(--mono);
  font-size: 10.5px;
  color: var(--muted);
}

.chart {
  position: relative;
  margin: 10px 0 8px;
}

.chart svg {
  display: block;
  width: 100%;
  height: 104px;
  overflow: visible;
}

.chart .line {
  fill: none;
  stroke: var(--ink);
  stroke-width: 1.4;
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
}

.chart .envelope {
  fill: var(--ink);
  opacity: 0.16;
  stroke: none;
  vector-effect: non-scaling-stroke;
}

.chart .grid-line {
  stroke: var(--rule);
  stroke-width: 1;
  vector-effect: non-scaling-stroke;
}

.chart .band {
  fill: var(--warn);
  opacity: 0.14;
}

.chart .band-edge {
  stroke: var(--warn);
  stroke-width: 1;
  stroke-dasharray: 2 3;
  vector-effect: non-scaling-stroke;
  opacity: 0.7;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 14px;
  font-size: 12px;
  color: var(--muted);
}

.meta b {
  font-family: var(--mono);
  font-weight: 500;
  color: var(--ink-soft);
}

.faults {
  margin-top: 6px;
  font-size: 12px;
  color: var(--warn);
}

.state {
  margin-top: 6px;
  font-size: 12.5px;
}

.state.ok {
  color: var(--pass);
}

.state.bad {
  color: var(--fail);
}

footer {
  margin-top: 34px;
  padding-top: 14px;
  border-top: 1px solid var(--rule);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 4px 16px;
  font-size: 11.5px;
  color: var(--muted);
}

@media (max-width: 760px) {
  .grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .masthead {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .headline {
    text-align: left;
  }

  .strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .strip > div:nth-child(odd) {
    border-left: 0;
    padding-left: 0;
  }
}
</style>
</head>
<body>
<div class="sheet">
  <header class="masthead">
    <div>
      <p class="wordmark">pre-sales-kit / kit seed</p>
      <h1>{{ view.title }}</h1>
      <p class="subtitle">{{ view.source }}</p>
    </div>
    <div class="headline">
      <span class="big{% if view.failed %} bad{% endif %}">{{ view.passed }}/{{ view.point_count }}</span>
      <span class="small">点位通过物理自检</span>
    </div>
  </header>

  <section class="strip">
    <div>
      <div class="k">时间窗</div>
      <div class="v">{{ view.window_start }} → {{ view.window_end }}</div>
    </div>
    <div>
      <div class="k">采样间隔 / 时长</div>
      <div class="v">{{ view.interval }} · {{ view.duration }}</div>
    </div>
    <div>
      <div class="k">每点位样本</div>
      <div class="v">{{ view.samples }}</div>
    </div>
    <div>
      <div class="k">总记录数</div>
      <div class="v">{{ view.total_rows }}</div>
    </div>
  </section>

  <section class="grid">
    {% for point in view.points %}
    <article class="point">
      <div class="point-header">
        <h3>{{ point.name }}{% if point.unit %} <span class="unit">{{ point.unit }}</span>{% endif %}</h3>
        <span class="badge">{{ point.model }}</span>
      </div>

      <div class="chart">
        <svg viewBox="0 0 880 104" preserveAspectRatio="none" role="img"
             aria-label="{{ point.name }} 曲线，范围 {{ point.minimum }} 到 {{ point.maximum }}">
          <line class="grid-line" x1="0" y1="52" x2="880" y2="52"></line>
          {% for fault in point.faults %}
          <rect class="band" x="{{ (fault.left / 100 * 880) | round(1) }}" y="0"
                width="{{ (fault.width / 100 * 880) | round(1) }}" height="104"></rect>
          <line class="band-edge" x1="{{ (fault.left / 100 * 880) | round(1) }}" y1="0"
                x2="{{ (fault.left / 100 * 880) | round(1) }}" y2="104"></line>
          <line class="band-edge" x1="{{ ((fault.left + fault.width) / 100 * 880) | round(1) }}" y1="0"
                x2="{{ ((fault.left + fault.width) / 100 * 880) | round(1) }}" y2="104"></line>
          {% endfor %}
          <path class="envelope" d="{{ point.chart.envelope }}"></path>
          <path class="line" d="{{ point.chart.path }}"></path>
        </svg>
      </div>

      <div class="meta">
        <span>量程 <b>{{ point.range }}</b></span>
        <span>实际 <b>{{ point.minimum }} – {{ point.maximum }}</b></span>
        <span>单步最大 <b>{{ point.max_step }}</b></span>
        <span>样本 <b>{{ point.count }}</b></span>
      </div>

      {% if point.faults %}
      <p class="faults">
        注入异常：
        {% for fault in point.faults %}
        {{ fault.label }}（{{ fault.window }}，{{ fault.magnitude }}）{% if not loop.last %} · {% endif %}
        {% endfor %}
      </p>
      {% endif %}

      {% if point.ok %}
      <p class="state ok">✓ 物理自检通过：没有越界、没有跳变</p>
      {% else %}
      <p class="state bad">✗ {{ point.issues | join("；") }}</p>
      {% endif %}
    </article>
    {% endfor %}
  </section>

  <footer>
    <span>pre-sales-kit v{{ view.version }} · 随机种子 {{ view.seed }} · {{ view.generated.strftime("%Y-%m-%d %H:%M:%S") }}</span>
    <span>单文件预览 · 曲线按 {{ view.samples }} 点绘制 · 可直接转发</span>
  </footer>
</div>
</body>
</html>
