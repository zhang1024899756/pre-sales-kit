<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ view.product }} · 兼容性矩阵</title>
<style>
{% include "_report.css" %}

.masthead {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 32px;
  align-items: end;
  padding-bottom: 22px;
  border-bottom: 2px solid var(--ink);
}

.wordmark {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--muted);
}

h1 {
  margin: 10px 0 6px;
  font-size: 28px;
  line-height: 1.2;
  font-weight: 650;
  letter-spacing: -0.01em;
}

.subtitle {
  font-size: 13px;
  color: var(--muted);
}

.updated {
  text-align: right;
  font-size: 12.5px;
  color: var(--muted);
}

.updated .date {
  display: block;
  margin-top: 4px;
  font-family: var(--mono);
  font-size: 15px;
  color: var(--ink-soft);
}

.strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-bottom: 1px solid var(--rule);
}

.strip > div {
  padding: 16px 16px 16px 0;
}

.strip > div + div {
  padding-left: 20px;
  border-left: 1px solid var(--rule);
}

.strip .k {
  font-size: 10.5px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
}

.strip .v {
  margin-top: 4px;
  font-family: var(--mono);
  font-size: 20px;
  font-weight: 600;
}

.strip [data-level="full"] .v { color: var(--pass); }
.strip [data-level="partial"] .v { color: var(--warn); }
.strip [data-level="unsupported"] .v { color: var(--fail); }
.strip [data-level="unknown"] .v { color: var(--skip); }

.dimension {
  margin-top: 34px;
}

.dimension h2 {
  font-size: 17px;
  font-weight: 600;
  margin-bottom: 4px;
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.dimension h2 .count {
  font-size: 11px;
  font-family: var(--mono);
  color: var(--muted);
  font-weight: 400;
}

table {
  width: 100%;
  margin-top: 8px;
  border-collapse: collapse;
  font-size: 13.5px;
}

th {
  padding: 6px 12px 6px 0;
  text-align: left;
  font-size: 10.5px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--muted);
  border-bottom: 1px solid var(--rule-strong);
}

td {
  padding: 9px 12px 9px 0;
  vertical-align: top;
  border-bottom: 1px solid var(--rule);
}

td:last-child,
th:last-child {
  padding-right: 0;
}

td.name {
  font-weight: 500;
}

.pill {
  display: inline-block;
  padding: 1px 8px;
  border-radius: var(--radius);
  font-size: 12px;
  white-space: nowrap;
}

[data-level="full"] .pill {
  color: var(--pass);
  background: var(--pass-bg);
}

[data-level="partial"] .pill {
  color: var(--warn);
  background: var(--warn-bg);
}

[data-level="unsupported"] .pill {
  color: var(--fail);
  background: var(--fail-bg);
}

[data-level="unknown"] .pill {
  color: var(--skip);
  background: var(--skip-bg);
}

td.note {
  color: var(--ink-soft);
}

td.note.empty {
  color: var(--muted);
}

.since {
  display: block;
  margin-top: 2px;
  font-size: 11.5px;
  color: var(--muted);
}

.notes {
  margin-top: 30px;
  padding: 14px 16px;
  border: 1px solid var(--rule);
  border-left: 3px solid var(--rule-strong);
  border-radius: var(--radius);
  font-size: 12.5px;
  line-height: 1.6;
  color: var(--muted);
}

footer {
  margin-top: 34px;
  padding-top: 14px;
  border-top: 1px solid var(--rule);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 4px 16px;
  font-size: 11.5px;
  color: var(--muted);
}

@media (max-width: 720px) {
  .masthead {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .updated {
    text-align: left;
  }

  .strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .strip > div:nth-child(odd) {
    border-left: 0;
    padding-left: 0;
  }

  table,
  thead,
  tbody,
  tr {
    display: block;
  }

  th {
    display: none;
  }

  td {
    padding: 2px 0;
    border: 0;
  }

  tr {
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
}
</style>
</head>
<body>
<div class="sheet">
  <header class="masthead">
    <div>
      <p class="wordmark">pre-sales-kit / kit compat</p>
      <h1>{{ view.product }}</h1>
      <p class="subtitle">兼容性矩阵{% if view.brand %} · {{ view.brand }}{% endif %}</p>
    </div>
    <div class="updated">
      数据更新
      <span class="date">{{ view.updated or "未标注" }}</span>
    </div>
  </header>

  <section class="strip">
    {% for count in view.counts %}
    <div data-level="{{ count.level }}">
      <div class="k">{{ count.label }}</div>
      <div class="v">{{ count.count }}</div>
    </div>
    {% endfor %}
  </section>

  {% for dimension in view.dimensions %}
  <section class="dimension">
    <h2>{{ dimension.label }}<span class="count">{{ dimension.entries | length }} 项</span></h2>
    <table>
      <thead>
        <tr>
          <th>环境</th>
          <th>支持情况</th>
          <th>说明</th>
        </tr>
      </thead>
      <tbody>
        {% for item in dimension.entries %}
        <tr data-level="{{ item.level }}">
          <td class="name">{{ item.name }}{% if item.since %}<span class="since">自 {{ item.since }} 起</span>{% endif %}</td>
          <td><span class="pill">{{ item.label }}</span></td>
          <td class="note{% if not item.note %} empty{% endif %}">{{ item.note or "—" }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endfor %}

  {% if view.combinations %}
  <section class="dimension">
    <h2>已验证的组合<span class="count">{{ view.combinations | length }} 项</span></h2>
    <table>
      <thead>
        <tr>
          {% for pair in view.combinations[0].pairs %}
          <th>{{ pair.label }}</th>
          {% endfor %}
          <th>结论</th>
          <th>说明</th>
        </tr>
      </thead>
      <tbody>
        {% for combination in view.combinations %}
        <tr data-level="{{ combination.level }}">
          {% for pair in combination.pairs %}
          <td class="name">{{ pair.value }}</td>
          {% endfor %}
          <td><span class="pill">{{ combination.label }}</span></td>
          <td class="note{% if not combination.note %} empty{% endif %}">{{ combination.note or "—" }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {% if view.notes %}
  <p class="notes">{{ view.notes }}</p>
  {% endif %}

  <footer>
    <span>数据来源：{{ view.source }}</span>
    <span>单文件 · 无外部资源 · {{ view.generated.strftime("%Y-%m-%d %H:%M") }}</span>
  </footer>
</div>
</body>
</html>
